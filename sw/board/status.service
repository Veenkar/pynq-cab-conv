# systemd unit: OLED status display (mode, REC time, IR name, peak meters).
# Install: sudo ./install_autostart.sh --oled
# Needs the SSD1306 128x32 module on /dev/i2c-0 (Arduino SCL/SDA pins), see README.
[Unit]
Description=Cab convolver OLED status display
After=cab-conv.service

[Service]
Type=simple
ExecStart=/bin/bash -lc "exec python3 -u /home/xilinx/cab_conv/status.py"
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
